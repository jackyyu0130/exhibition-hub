  "description": "社群只用於候選發現與人工審核；不得改寫官方展覽欄位。T1 透過 Meta Threads 官方 keyword_search API 建立匿名候選，沒有 Token 時安全跳過。",
  "sources": [
    {
      "id": "threads",
      "enabled": true,
      "mode": "official_keyword_api_review_only",
      "apiHost": "https://graph.threads.net",
      "activationSecret": "THREADS_ACCESS_TOKEN",
      "requiresOfficialAccessToken": true,
      "requiredPermission": "threads_keyword_search",
      "schedule": "每天 04:20、16:20（台灣時間）",
      "allowedAccountTypes": [
        "public"
      ],
      "saveFullText": false,
      "publishAuthorIdentity": false,
      "directPublish": false
    },
    {
      "id": "ptt",
      "enabled": true,
      "mode": "public_web_bbs_low_frequency",
      "boards": [
        "museum",
        "Art",
        "Drama-Ticket",
        "Indie-Film",
        "Japan_Travel",
        "Kaohsiung",
        "Tainan",
        "TaichungBun",
        "Taipei"
      ],
      "maxCandidatesPerRun": 40,
      "minDelaySeconds": 4,
      "saveFullText": false,
      "publishAuthorIdentity": false
    },
    {
      "id": "dcard",
      "enabled": false,
      "mode": "written_authorization_or_manual",
      "requiresWrittenAuthorization": true,
      "saveFullText": false,
      "publishAuthorIdentity": false
    },
    {
      "id": "instagram",
      "enabled": false,
      "mode": "official_api_or_manual_public_link",
