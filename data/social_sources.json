        "venue",
        "organizer",
        "festival"
      ],
      "saveFullText": false,
      "publishAuthorIdentity": false,
      "eventCandidateOnly": true
    },
    {
      "id": "facebook",
      "enabled": false,
      "mode": "official_api_or_manual_public_link",
      "requiresOfficialAccess": true,
